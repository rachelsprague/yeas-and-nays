#!/usr/bin/env bash
# Git pre-push hook: refuse to push any commit that has no recorded /pre-push
# review. This is the backstop behind .claude/hooks/confirm-push.py, which can
# only inspect command text; this hook sees the exact refs and commits being
# pushed, however the push was started. Install with `make hooks`.
#
# The /pre-push skill records a review as an empty file named for the commit
# under <git common dir>/pre-push-reviewed/. Also refused: branch deletions
# and annotated tags, which have no reviewed commit (a lightweight tag on a
# reviewed commit passes), and pushes that would rewrite the remote's history
# (not a fast-forward), even of a reviewed commit. Push those by hand with
# `git push --no-verify` after checking them.
set -euo pipefail

reviewed="$(git rev-parse --path-format=absolute --git-common-dir)/pre-push-reviewed"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    echo "pre-push: refusing to delete $remote_ref without a review." >&2
    status=1
  elif [ ! -f "$reviewed/$local_sha" ]; then
    echo "pre-push: no /pre-push review recorded for $local_ref (${local_sha:0:7})." >&2
    status=1
  elif [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: $remote_ref (${remote_sha:0:7}) isn't an ancestor of ${local_sha:0:7}; refusing a non-fast-forward push (fetch and rebase first)." >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: this repo is public. Run the /pre-push review first; it records each reviewed commit." >&2
fi
exit "$status"
